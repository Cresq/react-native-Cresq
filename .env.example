# Where the app sends a photo of a nutrition table to be read.
# Leave both empty and the app offers typing the figures in instead.
# See supabase/functions/read-label/index.ts for the other end.
EXPO_PUBLIC_LABEL_READER_URL=
EXPO_PUBLIC_LABEL_READER_KEY=

# The shared product shelf in Supabase (products by barcode). The publishable key is safe to ship.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_KEY=
